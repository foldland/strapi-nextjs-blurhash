{
  "name": "@foldland/strapi-nextjs-blurhash",
  "version": "1.2.9",
  "description": "A Strapi extension for generating and storing BlurHash strings, enhancing image loading visuals.",
  "keywords": [
    "blurhash",
    "nextjs",
    "strapi-plugin",
    "strapi"
  ],
  "license": "BSD-3-Clause",
  "author": {
    "name": "foldland Software GmbH",
    "email": "contact@fold.land",
    "url": "https://fold.land"
  },
  "type": "commonjs",
  "exports": {
    "./package.json": "./package.json",
    "./strapi-server": {
      "types": "./dist/src/index.d.ts",
      "source": "./src/index.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "strapi-plugin build",
    "check": "pnpm format:check && pnpm lint:check && pnpm typecheck && pnpm verify",
    "dev": "strapi-plugin watch",
    "format:check": "biome check --formatter-enabled=true --linter-enabled=false --assist-enabled=false",
    "format:write": "biome format --write",
    "link": "strapi-plugin watch:link",
    "lint:check": "biome check --formatter-enabled=false --linter-enabled=true --assist-enabled=true",
    "lint:write": "biome lint --write",
    "test": "echo \"No tests setup\"",
    "typecheck": "tsc --noEmit",
    "verify": "strapi-plugin verify"
  },
  "dependencies": {
    "sharp": "^0.35.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@foldland/biome-configs": "1.6.0",
    "@strapi/sdk-plugin": "6.1.1",
    "@strapi/strapi": "5.58.0",
    "@strapi/typescript-utils": "5.58.0",
    "@strapi/upload": "5.58.0",
    "@types/node": "24.19.2",
    "codemirror": "6.0.2",
    "typescript": "5.9.3"
  },
  "peerDependencies": {
    "@strapi/sdk-plugin": "^5.4.0 || ^6.0.0",
    "@strapi/strapi": "^5.0.0",
    "@strapi/types": "^5.0.0"
  },
  "peerDependenciesMeta": {
    "@strapi/types": {
      "optional": true
    }
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "24.22.0",
      "onFail": "download"
    },
    "packageManager": {
      "name": "pnpm",
      "version": "12.11.2",
      "onFail": "download"
    }
  },
  "strapi": {
    "kind": "plugin",
    "name": "strapi-nextjs-blurhash",
    "displayName": "Strapi Next.Js Blurhash",
    "description": "A Strapi extension for generating and storing BlurHash strings, enhancing image loading visuals."
  }
}
